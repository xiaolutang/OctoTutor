# OctoTutor 远程部署配置
# 复制此文件为 .remote.env 并填写实际值: cp .remote.env.example .remote.env

# 远程服务器地址
REMOTE_HOST=your-server-ip

# SSH 用户名
REMOTE_USER=ubuntu

# 远程部署目录
REMOTE_DEPLOY_DIR=/home/ubuntu/project/OctoTutor

# 目标平台架构（macOS M 芯片部署到 Linux x86 服务器需要交叉编译）
REMOTE_PLATFORM=linux/amd64

# Auth SDK 配置
AUTH_CLIENT_ID=your-production-client-id
AUTH_BASE_URL=https://auth.xiaolutang.top

# 后端服务密钥
DASHSCOPE_API_KEY=your-dashscope-api-key
JWT_SECRET_KEY=your-jwt-secret-key
NEWAPI_API_KEY=your-newapi-api-key
