# === OctoTutor Backend 配置 ===

# DashScope API Key（必填，缺少时启动报错）
DASHSCOPE_API_KEY=sk-your-api-key-here

# DashScope Embedding 配置
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_EMBEDDING_DIMENSION=768

# ChromaDB 持久化目录
CHROMA_PERSIST_DIR=data/chroma_db

# 数据目录
DATA_RAW_DIR=data/raw
DATA_PARSED_DIR=data/parsed
DATA_IMAGES_DIR=data/images

# 应用配置
APP_NAME=OctoTutor-API
APP_VERSION=0.1.0
DEBUG=false
