# === OctoTutor Backend 配置 ===

# DashScope API Key（必填，缺少时启动报错）
DASHSCOPE_API_KEY=sk-your-api-key-here

# DashScope Embedding 配置
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_EMBEDDING_DIMENSION=768

# ChromaDB 持久化目录
CHROMA_PERSIST_DIR=data/chroma_db

# 数据目录
DATA_RAW_DIR=data/raw
DATA_PARSED_DIR=data/parsed
DATA_IMAGES_DIR=data/images

# 应用配置
APP_NAME=OctoTutor-API
APP_VERSION=0.1.0
DEBUG=false

# NewAPI (OpenAI 兼容协议)
NEWAPI_API_KEY=
NEWAPI_BASE_URL=http://localhost:13000/v1
LLM_MODEL=glm-5.1

# R004: Reranker 配置
RERANK_TOP_N=3
RERANK_MODEL=gte-rerank
CHAT_MAX_CONTEXT_TOKENS=3000

# R004: BM25 + RRF 配置
BM25_ENABLED=true
RRF_K=60
RETRIEVAL_TOP_K=20
SIMILARITY_THRESHOLD=0.70
